# Copy to .env (gitignored) and fill in locally. Never paste real values into chat, issues or logs.
# Which variables are actually required will be decided after `catalog` confirms each endpoint's auth.

# NASA Earthdata Login (PO.DAAC / Harmony / Ocean Color) — or use ~/.netrc instead
EARTHDATA_USERNAME=
EARTHDATA_TOKEN=

# Optional export target (do not point at production without separate approval)
SEAGIS_DB_URL=
